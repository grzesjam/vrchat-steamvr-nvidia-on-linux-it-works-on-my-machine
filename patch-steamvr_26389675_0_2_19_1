NAME = Path(__file__).name
MARKER = b"Valve, please fix."


@dataclass(frozen=True)
class Edit:
    offset: int
    replacement: bytes


@dataclass(frozen=True)
class Patch:
    original_hash: bytes
    patched_hash: bytes
    edits: tuple[Edit, ...]

    @classmethod
    def from_dict(cls, data: dict) -> "Patch":
        return cls(
            bytes.fromhex(data["original_hash"]),
            bytes.fromhex(data["patched_hash"]),
            tuple(
                Edit(offset, bytes.fromhex(replacement))
                for offset, replacement in data["edits"]
            ),
        )

    def apply_to(self, data: bytes) -> bytes:
        payload = data.removesuffix(MARKER)
        digest = sha256(payload)
        if digest == self.patched_hash:
            return payload + MARKER
        if digest != self.original_hash:
            if payload != data:
                raise LookupError(
                    "already patched with another set of patches: "
                    "verify file integrity and restart"
                )
            raise LookupError("unrecognized file hash: this wrapper may need updating")
        result = BytesIO(payload)
        for edit in self.edits:
            result.seek(edit.offset)
            result.write(edit.replacement)
        patched = result.getvalue()
        if sha256(patched) != self.patched_hash:
            raise ValueError("patched file checksum mismatch")
        return patched + MARKER


